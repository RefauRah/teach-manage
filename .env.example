PORT=3000

# Turso / SQLite Database Configuration
# For local SQLite development (default, zero setup needed):
TURSO_DATABASE_URL=file:local.db
TURSO_AUTH_TOKEN=

# For Turso Cloud (optional, for deployment):
# TURSO_DATABASE_URL=libsql://your-db-name.turso.io
# TURSO_AUTH_TOKEN=your_turso_auth_token

# Authentication Secrets
JWT_SECRET=supersecretkeychangeinproduction
JWT_REFRESH_SECRET=anothersecretkeychangeinproduction
JWT_ACCESS_EXPIRY_MINUTES=60
JWT_REFRESH_EXPIRY_DAYS=7
